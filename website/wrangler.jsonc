// cida.xuanwo.io: a Worker that only serves the static site scripts/build-website.py writes.
// Deployed by .github/workflows/website.yml; see "Website" in docs/development.md.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "cida-website",
  "account_id": "d100c32126daec20555857d36239c412",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../build/website",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "cida.xuanwo.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
